{
  "name": "gryd",
  "version": "1.0.0",
  "description": "Game discovery and personal library application",
  "main": "backend/src/app.js",
  "scripts": {
    "build:css": "sass frontend/styles/scss/main.scss frontend/styles/css/main.css --no-source-map",
    "dev": "npm run build:css && concurrently \"npm:dev:worker\" \"npm:dev:frontend\"",
    "dev:worker": "wrangler dev --ip 0.0.0.0 --port 8787",
    "dev:frontend": "serve frontend -l 3000"
  },
