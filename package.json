  "bugs": {
    "url": "https://github.com/yvilram/GRYD/issues"
  },
  "homepage": "https://github.com/yvilram/GRYD#readme",
  "dependencies": {
    "@supabase/server": "^1.9.2",
    "@supabase/supabase-js": "^2.118.0",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "howlongtobeat": "^1.8.0",
    "lz-string": "^1.5.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
